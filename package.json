{
  "name": "presidency-bingo",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @presidency-bingo/api test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prepare": "husky",
    "db:migrate": "pnpm --filter @presidency-bingo/api db:migrate",
    "test:smoke": "pnpm --filter @presidency-bingo/web test:e2e",
    "db:seed": "pnpm --filter @presidency-bingo/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,yml,yaml,md}": "biome check --write --no-errors-on-unmatched"
  }
}
