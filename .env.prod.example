# --- Public address -------------------------------------------------------
# With a domain (DNS A record → server IP): automatic HTTPS.
DOMAIN=app.example.com
APP_URL=https://app.example.com
# Without a domain, on the server's IP (no HTTPS, so no secure cookies and no Google sign-in):
# DOMAIN=:80
# APP_URL=http://203.0.113.10
# COOKIE_SECURE=false

# --- Database ---------------------------------------------------------------
POSTGRES_USER=app
# openssl rand -base64 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Auth ---------------------------------------------------------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_ENABLED=true

# --- Email (see apps/api/.env.example for Gmail / Resend presets) ------------
MAIL_FROM="Presidency Bingo <you@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=

# --- Google OAuth (redirect URI: ${APP_URL}/api/auth/google/callback) --------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
