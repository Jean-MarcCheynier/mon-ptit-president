generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  name            String
  avatarUrl       String?   @map("avatar_url")
  locale          String    @default("fr")
  // Null for accounts created through an OAuth provider only.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  accounts           Account[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// One row per issued refresh token. Tokens rotated from the same login share a familyId,
// so reuse of a rotated token revokes the whole chain.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash")
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Election {
  id                String   @id @default(uuid(7)) @db.Uuid
  slug              String   @unique
  name              String
  firstRoundAt      DateTime @map("first_round_at")
  secondRoundAt     DateTime @map("second_round_at")
  // After this instant, predictions are read-only.
  predictionsLockAt DateTime @map("predictions_lock_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  candidates ElectionCandidate[]

  @@map("elections")
}

// The person, independent of any election.
model Politician {
  id          String   @id @default(uuid(7)) @db.Uuid
  // Stable key used by the seed.
  slug        String   @unique
  name        String
  photoUrl    String?  @map("photo_url")
  photoCredit String?  @map("photo_credit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  candidacies ElectionCandidate[]

  @@map("politicians")
}

enum CandidateStatus {
  POTENTIAL
  DECLARED
  QUALIFIED
  NOT_QUALIFIED
  WITHDRAWN
}

// A politician's situation in a given election.
model ElectionCandidate {
  id           String          @id @default(uuid(7)) @db.Uuid
  electionId   String          @map("election_id") @db.Uuid
  politicianId String          @map("politician_id") @db.Uuid
  status       CandidateStatus @default(POTENTIAL)
  partyLabel   String          @map("party_label")
  tagline      String
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  election   Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@unique([electionId, politicianId])
  @@map("election_candidates")
}
